# ─────────────────────────────────────────────────────────────
# .htaccess — Harrison Muhoro Portfolio
# Minimal version for Wasmer Edge compatibility
# ─────────────────────────────────────────────────────────────

# Wasmer Edge does not support Options -Indexes, php_flag, Header, ExpiresByType, etc.
# Keep this file as minimal as possible for Wasmer Edge to route correctly.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't rewrite real files or directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything through index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# (All other Apache-specific directives like mod_headers, mod_expires, mod_deflate
# and php_flags have been removed because they cause 'Htaccess evaluation failed' 
# on Wasmer Edge. Security headers are handled in PHP via config/security_headers.php)
