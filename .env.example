# ─── COPY TO .env (or set as real environment variables) ──────────────────────
# .env itself is gitignored — never commit secrets.

# ─── REQUIRED FOR EMAIL DELIVERY ──────────────────────────────────────────────
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — MUST be on a domain verified in your Resend account.
# Verified domain for this site: harrisonmuhoro.me
MAIL_FROM=no-reply@harrisonmuhoro.me

# Override the recipient (defaults to CONTACT_EMAIL)
# MAIL_TO=zionmuhoro@gmail.com

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
# Base path when the app lives in a subdirectory (WAMP: /harrison-portfolio)
# BASE_PATH=/harrison-portfolio

# Contact form recipient
# CONTACT_EMAIL=zionmuhoro@gmail.com

# Rate limiter: REQUIRED in production. Set an absolute, writable directory
# outside the public web root, on storage that persists across deploys/restarts.
# Missing, relative, in-root, or unverifiable paths are rejected; storage
# failures deny requests (fail-closed). Grant the PHP worker user
# create/read/write permissions (typically 0700 owned by that user).
# Do not use ephemeral storage.
# RATE_LIMIT_DIR=/var/lib/harrison-portfolio/rl

# Public web root used to VERIFY RATE_LIMIT_DIR is outside it. Normally
# DOCUMENT_ROOT is enough; set this explicitly on hosts where
# DOCUMENT_ROOT is missing or unreliable (e.g. some PaaS runtimes).
# If neither resolves in production, rate limiting fails closed.
# PUBLIC_ROOT=/var/www/html

# Production defaults to fail-closed; development defaults to fail-open.
# RATE_LIMIT_FAIL_MODE=closed
# Session/CSRF secret — set a long random string in production
# APP_SECRET=change-me-to-a-long-random-string
