# ─── COPY TO .env (or set as real environment variables) ──────────────────────
# .env itself is gitignored — never commit secrets.

# ─── REQUIRED FOR EMAIL DELIVERY ──────────────────────────────────────────────
# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — MUST be on a domain verified in your Resend account.
# Verified domain for this site: harrisonmuhoro.me
MAIL_FROM=no-reply@harrisonmuhoro.me

# Override the recipient (defaults to CONTACT_EMAIL)
# MAIL_TO=zionh191@gmail.com

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
# Base path when the app lives in a subdirectory (WAMP: /harrison-portfolio)
# BASE_PATH=/harrison-portfolio

# Contact form recipient
# CONTACT_EMAIL=zionh191@gmail.com

# Rate limiter: persistent state directory (default: storage/rate_limits)
# RATE_LIMIT_DIR=/var/lib/harrison-portfolio/rl

# Rate limiter failure policy: 'open' (default) or 'closed'
# RATE_LIMIT_FAIL_MODE=open

# Session/CSRF secret — set a long random string in production
# APP_SECRET=change-me-to-a-long-random-string
